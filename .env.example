# Database Configuration (PostgreSQL native)
# If your local PostgreSQL 16 runs on port 5433 (common on Windows multi-install), adjust port accordingly:
DATABASE_URL=postgresql+asyncpg://fleetmaint:fleetmaint@localhost:5432/fleetmaint
DATABASE_URL_TEST=postgresql+asyncpg://fleetmaint:fleetmaint@localhost:5432/fleetmaint_test
TEST_DATABASE_URL=postgresql+asyncpg://fleetmaint:fleetmaint@localhost:5432/fleetmaint_test

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & JWT (Phase 3+)
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32chars
